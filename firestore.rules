rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AVISO: cualquier usuario autenticado anónimamente puede escribir.
    // El código 12345 es solo una barrera de interfaz, NO una credencial segura.
    // Uso temporal para un torneo informal. NO usar para datos sensibles.
    match /tournaments/{id} {
      allow read, write: if request.auth != null;
    }
    match /public/{id} {
      allow get: if id == 'mahanaim-roster';
      allow list: if false;
      allow write: if request.auth != null;
    }
    match /playerResults/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }
  }
}
