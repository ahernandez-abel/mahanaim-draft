rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el navegador cuyo UID se autorizó puede modificar el torneo.
    // Si cambia el navegador o se borran sus datos, cambia también el UID.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'Kwf1VowbxKdje6ZYumc71N2ZPTH3';
    }
    match /tournaments/{id} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /public/{id} {
      allow get: if id == 'mahanaim-roster';
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /playerResults/{id} {
      // Resultados individuales consultables por ID, sin permitir listarlos.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
  }
}
