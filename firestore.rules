rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isPlayer(id) {
      return request.auth != null
        && request.auth.token.role == 'player'
        && request.auth.token.playerId == id;
    }

    match /tournaments/{id} {
      allow get, list, create, update, delete: if isAdmin();
    }
    match /public/{id} {
      // El roster publicado contiene solo ID y nombre, nunca equipos.
      allow get: if id == 'mahanaim-roster';
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /playerResults/{id} {
      allow get: if isAdmin() || isPlayer(id);
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
  }
}
